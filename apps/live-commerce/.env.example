APP_ENV=development
DATABASE_PATH=./data/live-commerce.db
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# mock: generates a local demo segment; queue: submits to fal and waits for signed webhooks.
FAL_MODE=mock
FAL_KEY=
FAL_MODEL_ID=minimax/h3-max/text-to-video
FAL_VERIFY_WEBHOOKS=true
FAL_JWKS_URL=https://rest.fal.ai/.well-known/jwks.json
FAL_WEBHOOK_PATH=/v1/webhooks/fal
FAL_JOB_DEADLINE_SECONDS=90
MOCK_GENERATION_DELAY_SECONDS=1.0
MOCK_ASSET_URL=/static/demo-segment.mp4

EVENT_REPLAY_LIMIT=250
AUTO_SEED_PRODUCTS=true
